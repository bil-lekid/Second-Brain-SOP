views:
  - type: table
    name: Table
    filters:
      and:
        - file.tags.containsAny("standardoperatingdocument")
    order:
      - file.name
      - tags
    sort: []
  - type: kanban
    name: Status
    filters:
      and:
        - file.tags.containsAny("StandardOperatingDocument")
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - file.tags
    sort:
      - property: file.tags
        direction: DESC
    columnWidth: 270
  - type: cards
    name: Divisi
    filters:
      and:
        - file.tags.containsAny("StandardOperatingDocument")
    groupBy:
      property: Divisi
      direction: ASC
